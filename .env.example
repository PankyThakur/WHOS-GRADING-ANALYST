# ── OpenRouter ──────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Models ──────────────────────────────────────────────────
# Claim extractor
EXTRACTOR_MODEL=z-ai/glm-5.2

# Judge (different family = less self-preference bias)
JUDGE_MODEL=google/gemini-3.7-flash

# ── Embeddings (local, no API key) ──────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Chroma ──────────────────────────────────────────────────
CHROMA_PATH=./vectorstore
CHROMA_COLLECTION=sec_filings

# ── SEC EDGAR ───────────────────────────────────────────────
# Your email — EDGAR requires this in the User-Agent header
EDGAR_USER_AGENT=your_name your_email@example.com
